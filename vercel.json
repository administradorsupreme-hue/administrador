{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/oauth/google",
      "destination": "/api/index.js?route=oauth/google"
    },
    {
      "source": "/api/oauth/google/callback",
      "destination": "/api/index.js?route=oauth/google/callback"
    },
    {
      "source": "/api/oauth/discord",
      "destination": "/api/index.js?route=oauth/discord"
    },
    {
      "source": "/api/oauth/discord/callback",
      "destination": "/api/index.js?route=oauth/discord/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?route=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}