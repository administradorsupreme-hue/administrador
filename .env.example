SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_KEY
ECLIPSE_API_KEY=COLOQUE_A_CHAVE_SECRETA
ECLIPSE_WEBHOOK_SECRET=COLOQUE_O_SEGREDO_DO_WEBHOOK
